<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sportsstore.mapper.AddressMapper">

    <resultMap id="addressMap" type="Address">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="receiverName" column="receiver_name"/>
        <result property="phone" column="phone"/>
        <result property="province" column="province"/>
        <result property="city" column="city"/>
        <result property="district" column="district"/>
        <result property="detail" column="detail"/>
        <result property="isDefault" column="is_default"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <select id="findByUserId" resultMap="addressMap">
        SELECT * FROM `address` WHERE user_id = #{userId} ORDER BY is_default DESC, create_time DESC
    </select>

    <select id="findById" resultMap="addressMap">
        SELECT * FROM `address` WHERE id = #{id}
    </select>

    <select id="findDefaultByUserId" resultMap="addressMap">
        SELECT * FROM `address` WHERE user_id = #{userId} AND is_default = 1 LIMIT 1
    </select>

    <insert id="insert" parameterType="Address" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `address` (user_id, receiver_name, phone, province, city, district, detail, is_default)
        VALUES (#{userId}, #{receiverName}, #{phone}, #{province}, #{city}, #{district}, #{detail},
                COALESCE(#{isDefault}, 0))
    </insert>

    <update id="update" parameterType="Address">
        UPDATE `address`
        <set>
            <if test="receiverName != null">receiver_name = #{receiverName},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="province != null">province = #{province},</if>
            <if test="city != null">city = #{city},</if>
            <if test="district != null">district = #{district},</if>
            <if test="detail != null">detail = #{detail},</if>
            <if test="isDefault != null">is_default = #{isDefault},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="delete">
        DELETE FROM `address` WHERE id = #{id}
    </delete>

    <update id="clearDefault">
        UPDATE `address` SET is_default = 0 WHERE user_id = #{userId}
    </update>

    <update id="setDefault">
        UPDATE `address` SET is_default = #{isDefault} WHERE id = #{id}
    </update>

    <select id="countByUserId" resultType="int">
        SELECT COUNT(*) FROM `address` WHERE user_id = #{userId}
    </select>
</mapper>
